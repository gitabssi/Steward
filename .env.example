# Steward — environment template. Copy to .env and fill in.
# The real .env is gitignored; nothing here is a secret.
# All Google Cloud auth uses Application Default Credentials
# (gcloud auth application-default login) or Workload Identity on
# Cloud Run / Agent Runtime — no key files, ever.

# Vertex AI (default). Gemini 3.x serves from the `global` endpoint;
# regional infrastructure (Agent Runtime, Cloud Run, Model Armor) is
# pinned separately to us-central1 in the Makefile and terraform.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# BigQuery — real EPA NPDES corpus + backtest
BQ_DATASET=steward_npdes

# Fleet
STEWARD_FACILITY_SEED=data/seeds/cedar-ridge.json

# Edge (self-hosted Gemma — never a Vertex API; the OT boundary is the point)
# gemma4:e2b on CPU (Cloud Run); gemma4:e4b where there is an accelerator
EDGE_MODEL=gemma4:e2b
EDGE_PORT=8090
