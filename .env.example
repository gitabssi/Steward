# Steward — environment template. Copy to .env and fill in.
# The real .env is gitignored; nothing here is a secret.
# All Google Cloud auth uses Application Default Credentials
# (gcloud auth application-default login) or Workload Identity on
# Cloud Run / Agent Runtime — no key files, ever.

# Vertex AI (default). Gemini 3.x serves from the `global` endpoint;
# regional infrastructure (Agent Runtime, Cloud Run, Model Armor) is
# pinned separately to us-central1 in the Makefile and terraform.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# BigQuery — real EPA NPDES corpus + backtest
BQ_DATASET=steward_npdes

# Model Armor — the managed screener for inbound documents.
# Regional, and deliberately NOT reusing GOOGLE_CLOUD_LOCATION above:
# that is `global` for Gemini, and a global endpoint here 404s.
# Unset = the local screener runs, and the ledger says so.
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=steward-inbound

# Memory Bank — where learned facts live across shifts.
# On Agent Runtime the platform injects GOOGLE_CLOUD_AGENT_ENGINE_ID and
# nothing here is needed. On Cloud Run, point at the same engine so both
# surfaces share one bank (`make memory-bank` resolves it for you).
# Regional, for the same reason as Model Armor above.
AGENT_ENGINE_MEMORY_BANK=
STEWARD_MEMORY_BANK_LOCATION=us-central1
# The bank's partition key. Must match across surfaces or nothing carries.
STEWARD_MEMORY_SCOPE=cedar-ridge-operator
# Unset AGENT_ENGINE_MEMORY_BANK = facts persist to this file, recorded
# in the ledger as the active backend rather than implied.
STEWARD_MEMORY_PATH=/tmp/steward-memory.json

# Observability — turns on OTel export so ledger trace ids resolve in
# Cloud Trace instead of reading `untraced-*`.
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SERVICE_NAME=steward

# Fleet
STEWARD_FACILITY_SEED=data/seeds/cedar-ridge.json

# Edge (self-hosted Gemma — never a Vertex API; the OT boundary is the point)
# gemma4:e2b on CPU (Cloud Run); gemma4:e4b where there is an accelerator
EDGE_MODEL=gemma4:e2b
EDGE_PORT=8090
